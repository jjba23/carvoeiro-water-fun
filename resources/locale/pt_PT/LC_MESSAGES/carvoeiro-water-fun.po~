#: src/carvoeiro-water-fun/html.scm:368
msgid ""
"Civil Liability Insurance Policy No. 85/25935 Maritime Tourism €50,000.00"
msgstr ""
"Apólice de Seguro de Responsabilidade Civil nº 85/25935 Turismo Marítimo "
"50.000,00 €"

